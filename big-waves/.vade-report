// ... other imports

export default function App() {
  return (
    <ThemeProvider>
      <BrowserRouter>
        <Navbar />
        <main>
          <Routes>
            {/* routes */}
          </Routes>
        </main>
      </BrowserRouter>
      <Analytics />
